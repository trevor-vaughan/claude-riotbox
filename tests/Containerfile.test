# ─────────────────────────────────────────────────────────────────────────────
# Lightweight test image for setup.sh and install.sh
# CentOS Stream 10 with podman, fuse-overlayfs, task, and venom.
# ─────────────────────────────────────────────────────────────────────────────
FROM quay.io/centos/centos:stream10

# util-linux is here for setpriv, which the uid-0 run of this image
# (`task test:as-root`, and the matching step in .github/workflows/test.yml)
# needs: the probe case in tests/doctor-context-mode.venom.yml drops to uid
# 65534 rather than skipping, and hard-fails when setpriv is absent. The base
# image ships only util-linux-core, which does not carry it. The packages
# below happen to pull the full util-linux in transitively today — listing it
# makes that a declared dependency instead of something a future dependency
# resolution can quietly take away.
RUN dnf -y install \
        bash \
        git \
        gnupg2 \
        podman \
        fuse-overlayfs \
        jq \
        util-linux \
    && dnf clean all

# venom (integration test runner)
# TODO(security): No checksums or signatures published upstream.
RUN curl -sSfL -o /usr/local/bin/venom \
        https://github.com/ovh/venom/releases/latest/download/venom.linux-amd64 && \
    chmod +x /usr/local/bin/venom

# git-filter-repo (single-file Python script)
# TODO(security): Fetched from main branch with no checksum verification.
#   Consider pinning to a tagged release.
RUN dnf -y install python3 && dnf clean all && \
    curl -sSfL https://raw.githubusercontent.com/newren/git-filter-repo/main/git-filter-repo \
        -o /usr/local/bin/git-filter-repo && \
    chmod +x /usr/local/bin/git-filter-repo

# task
RUN curl --proto '=https' --tlsv1.2 -sSf https://taskfile.dev/install.sh | \
    sh -s -- -b /usr/local/bin

# git-cliff — generates CHANGELOG.md for `task release:bump`, exercised by
# tests/release-bump.venom.yml. Unlike venom and git-filter-repo above,
# upstream publishes a digest, so the pinned checksum is verified here.
ARG GIT_CLIFF_VERSION=2.13.1
ARG GIT_CLIFF_SHA512=e716cce3a07dda41b1e370d6afbd7a59eb3d4739509fb7856aeec8da2be28c0396584e29e106141c1a1c535c1827dbc1f60417524f5cfb1da9e11f700bd00f30
RUN curl --proto '=https' --tlsv1.2 -sSfL \
        -o /tmp/git-cliff.tar.gz \
        "https://github.com/orhun/git-cliff/releases/download/v${GIT_CLIFF_VERSION}/git-cliff-${GIT_CLIFF_VERSION}-x86_64-unknown-linux-gnu.tar.gz" && \
    echo "${GIT_CLIFF_SHA512}  /tmp/git-cliff.tar.gz" | sha512sum -c - && \
    tar -xzf /tmp/git-cliff.tar.gz -C /tmp && \
    install -m 0755 "/tmp/git-cliff-${GIT_CLIFF_VERSION}/git-cliff" /usr/local/bin/git-cliff && \
    rm -rf /tmp/git-cliff.tar.gz "/tmp/git-cliff-${GIT_CLIFF_VERSION}"

# git-ai — the real binary, not a fixture.
#
# Five cases in tests/git-ai.venom.yml exercise upstream directly: the config
# writes, `install-hooks`, the end-to-end note on refs/notes/ai, and the drift
# guard that is this project's early warning for upstream reshaping what the
# strip verbs read. Each skips when the binary is absent, so without this
# install they all reported PASS in CI having run nothing — and the drift guard,
# whose entire value is running against the real thing, was the biggest loss.
#
# The pin is duplicated from the runtime Containerfile because the two images
# are separate builds with no shared ARG. A case in the suite asserts the two
# agree, so a drift is a red test rather than a test image quietly exercising a
# release RiotBox does not ship. Refresh both together — the runtime
# Containerfile carries the instructions.
#
# amd64 only: this image's venom download is already amd64-only, and upstream
# names that asset git-ai-linux-x64.
ARG GIT_AI_VERSION=v1.7.4
ARG GIT_AI_SHA256_AMD64=1f80c4affa44d9a21667e930b7aa6ac94f7c2f46bf216d7664bab84c7a8b62c2
RUN curl --proto '=https' --tlsv1.2 -sSfL \
        -o /tmp/git-ai \
        "https://github.com/git-ai-project/git-ai/releases/download/${GIT_AI_VERSION}/git-ai-linux-x64" && \
    echo "${GIT_AI_SHA256_AMD64}  /tmp/git-ai" | sha256sum -c - && \
    install -m 0755 /tmp/git-ai /usr/local/bin/git-ai && \
    rm -f /tmp/git-ai && \
    git-ai --version

# Declares that this environment provides git-ai, which turns the suite's SKIP
# branches into failures here while leaving them intact for a maintainer running
# the suite on a bare host. Kept next to the install above so the claim and the
# binary are edited together.
ENV RIOTBOX_REQUIRE_GIT_AI=1

# Non-root test user
ARG HOST_UID=1000
RUN useradd -l -m -u ${HOST_UID} -s /bin/bash testuser 2>/dev/null || \
    useradd -l -m -s /bin/bash testuser

USER testuser
WORKDIR /home/testuser/riotbox

# This is a test-only image used only in CI; no daemon is running. The check
# verifies the core test tooling (venom) is present and executable.
# DL3025: the probe needs a shell — `command` is a builtin and >/dev/null is
# shell redirection, so exec form would only re-wrap this in /bin/sh -c. The
# rule's rationale (signal delivery to PID 1) does not apply to a healthcheck.
# hadolint ignore=DL3025
HEALTHCHECK --interval=30s --timeout=5s --retries=1 \
    CMD command -v venom >/dev/null 2>&1
